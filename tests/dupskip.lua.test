-- SPDX-License-Identifier: AGPL-3.0-or-later
-- Run against real Meguru modules; only the KOReader host and HTTP are mocked.
local meguru = assert(arg[1], "usage: luajit tests/dupskip.lua.test /path/to/meguru [/path/to/koreader]")
package.path = meguru .. "/?.lua;" .. (arg[2] and arg[2] .. "/common/?.lua;" or "") .. package.path
local json = require("dkjson")
package.loaded.socket = {}
require("socket.url")
require("ltn12")
local original_time = os.time
local state
local function equal(actual, expected, why)
    assert(actual == expected, (why or "mismatch") .. ": expected " .. tostring(expected) .. ", got " .. tostring(actual))
end
local logger = { dbg = function() end, info = function() end,
    warn = function(message) state.logs[#state.logs + 1] = message end }
package.loaded.logger = logger
package.loaded.datastorage = {}
package.loaded["meguru/sources"] = {}
package.loaded["meguru/net"] = {
    jsonDecoder = function() return state.decoder_available and json or nil end,
    fetchFeed = function() error("unexpected feed request") end,
}
local socketutil = {}
function socketutil:set_timeout(block, total)
    self.block_timeout, self.total_timeout = block, total
end
function socketutil:reset_timeout() self:set_timeout(60, -1) end
function socketutil.table_sink(chunks)
    local started = os.time()
    return function(chunk)
        if os.time() - started > socketutil.total_timeout then return nil, "sink timeout" end
        if chunk then chunks[#chunks + 1] = chunk end
        return 1
    end
end
package.loaded.socketutil = socketutil
package.loaded["socket.http"] = { request = function(request)
    state.requests[#state.requests + 1] = request
    equal(request.method, "POST")
    equal(request.redirect, false, "redirects must not forward credentials")
    equal(socketutil.block_timeout, 2)
    equal(socketutil.total_timeout, 4)
    local chunks = {}
    while true do
        local chunk = request.source()
        if not chunk then break end
        chunks[#chunks + 1] = chunk
    end
    local body = table.concat(chunks)
    equal(request.headers["Content-Length"], tostring(#body))
    equal(request.headers["Content-Type"], "application/json")
    local query = assert(json.decode(body))
    equal(query.query, "query($mangaId:Int!){chapters(condition:{mangaId:$mangaId}){nodes{id chapterNumber scanlator}}}")
    equal(query.variables.mangaId, state.expected_manga or 7)
    if state.http_error then error("simulated transport exception") end
    if state.no_status then return nil, "timeout" end
    if state.slow then state.now = state.now + 5 end
    local ok, reason = request.sink(state.body or json.encode(state.response))
    if not ok then return nil, reason end
    request.sink(nil)
    return 1, state.code or 200, {}
end }
package.loaded.userpatch = { registerPatchPluginFunc = function(name, callback)
    equal(name, "meguru")
    state.callbacks[#state.callbacks + 1] = callback
end }
os.time = function() return state.now end

local Feed, original_neighbor, original_collect, driver
local function reset(skip_install)
    state = { callbacks = {}, requests = {}, logs = {}, now = 1000, decoder_available = true }
    socketutil:set_timeout(17, 29)
    package.loaded["meguru/feed"] = nil
    Feed = require("meguru/feed")
    driver = require("meguru/driver/suwayomi")
    original_neighbor, original_collect = Feed.neighbor, Feed.collect
    dofile("2-newedia-meguru-dupskip.lua")
    equal(Feed.neighbor, original_neighbor, "installation must be deferred")
    if not skip_install then state.callbacks[1]({ name = "meguru" }) end
end

local function fixture(numbers, scanlators, keys)
    local entries, nodes = {}, {}
    for i, number in ipairs(numbers) do
        local key = keys and keys[i] or tostring(i)
        entries[i] = { id = "urn:suwayomi:chapter:" .. key,
            title = "Unhelpful title", summary = "Progress | 0/20",
            link = {{ rel = "subsection", href = "/api/opds/v1.2/series/7/chapter/" .. (i - 1) .. "/metadata" }} }
        nodes[i] = { id = i, chapterNumber = number,
            scanlator = scanlators and scanlators[i] or "Group A" }
    end
    state.response = { data = { chapters = { nodes = nodes } } }
    return { complete = true, pages = {{ url = "https://reader.invalid/api/opds/v1.2/series/7/chapters",
        feed = { entry = entries } }} },
        { driver = driver, url = "https://reader.invalid/api/opds/v1.2/series/7/chapters?lang=en&sort=number_asc",
            walker_opts = {}, ctx = { lang = "en" } }
end
local function sequence(walker, plan)
    local items, duplicates = Feed.collect(walker, plan)
    return Feed.ordered(items, { title_order = plan.driver.orderFromTitles }), duplicates
end
local function key(item) return item and item.item_key end
local function nextIs(seq, current, expected, which)
    equal(key(Feed.neighbor(seq, current, which or "next")), expected,
        tostring(current) .. " " .. (which or "next"))
end
local passed = 0
local function test(name, run)
    reset()
    local ok, message = pcall(run)
    if not ok then error(name .. ": " .. tostring(message), 0) end
    equal(socketutil.block_timeout, 17, "block timeout restored")
    equal(socketutil.total_timeout, 29, "total timeout restored")
    passed = passed + 1
    print("ok " .. passed .. " - " .. name)
end

test("real feed dedupe, order, IDs and progress survive navigation changes", function()
    local walker, plan = fixture({1, 1, 2, 2, 3}, {"A", "B", "B", "A", "B"})
    local entries = walker.pages[1].feed.entry
    entries[6] = entries[1]
    entries[1], entries[5] = entries[5], entries[1]
    local seq, duplicates = sequence(walker, plan)
    equal(#seq, 5)
    equal(duplicates, 1)
    equal(key(original_neighbor(seq, "1", "next")), "2", "baseline visits alternate release")
    nextIs(seq, "1", "4")
    nextIs(seq, "2", "3")
    nextIs(seq, "4", "1", "previous")
    nextIs(seq, "3", "2", "previous")
    nextIs(seq, "5", "3", "previous")
    nextIs(seq, "1", nil, "previous")
    nextIs(seq, "5", nil)
    nextIs(seq, "absent", nil)
    nextIs(seq, nil, nil)
    for i, item in ipairs(seq) do
        equal(item.item_key, tostring(i))
        equal(item.last_read, 0)
        equal(item.progress_total, 20)
        equal(item.chapterNumber, nil, "metadata must remain private")
        equal(item.username, nil)
    end
    equal(#state.requests, 1, "neighbor must not do HTTP")
    equal(key(Feed.firstUnfinished(seq)), "1", "resume is unchanged")
    equal(key(Feed.firstIn(seq)), "1")
end)

test("manual and auto-next use the same exported Feed seam", function()
    local file = assert(io.open(meguru .. "/meguru/ui/reader.lua"))
    local reader = file:read("*a"); file:close()
    assert(reader:find("return Feed.neighbor(sequence, context.item_key, which)", 1, true))
    assert(reader:find("local item, reason = neighborFromFeed(doc, context, which)", 1, true))
    assert(reader:find('pcall(neighborFromFeed, ui.document, context, "next")', 1, true))
    local seq = sequence(fixture({1, 1, 2}))
    local function manual() return Feed.neighbor(seq, "1", "next") end
    local function automatic() return pcall(Feed.neighbor, seq, "1", "next") end
    equal(key(manual()), "3")
    local ok, item = automatic(); equal(ok, true); equal(key(item), "3")
end)

test("nearest fallback and empty scanlators", function()
    local walker, plan = fixture({1, 1, 2, 2, 3}, {"", "  ", "A", "B", "C"})
    local seq = sequence(walker, plan)
    nextIs(seq, "1", "3")
    nextIs(seq, "2", "3")
    nextIs(seq, "5", "4", "previous")
end)

test("zero, fractions, unknown and negative numbers stay distinct", function()
    local seq = sequence(fixture({0, 0, 0.5, 0.5, false, 1, 1, -1, -1, 2}))
    nextIs(seq, "1", "3")
    nextIs(seq, "3", "5")
    nextIs(seq, "5", "6")
    nextIs(seq, "6", "5", "previous")
    nextIs(seq, "6", "8")
    nextIs(seq, "8", "9")
    nextIs(seq, "9", "10")
end)

test("leaving an unknown special keeps scanlator preference in either direction", function()
    local seq = sequence(fixture({10, 10, false, 12, 12}, {"A", "B", "A", "B", "A"}))
    nextIs(seq, "1", "3")
    nextIs(seq, "3", "5")
    nextIs(seq, "3", "1", "previous")
    nextIs(seq, "5", "3", "previous")
    state.now = state.now + 61
    seq = sequence(fixture({10, false, 12, 12}, {"A", "", "B", "A"}))
    nextIs(seq, "2", "3")
end)

test("malformed numbers remain individual stops", function()
    for _, bad in ipairs({"1", false, json.null, math.huge, -math.huge}) do
        state.now = state.now + 61
        local walker, plan = fixture({1, 1, bad, bad, 2})
        local seq = sequence(walker, plan)
        nextIs(seq, "1", "3")
        nextIs(seq, "3", "4")
        nextIs(seq, "4", "5")
    end
    state.now = state.now + 61
    local walker, plan = fixture({1, 1, 2, 2, 3})
    state.body = json.encode(state.response):gsub('"chapterNumber":2', '"chapterNumber":1e999')
    local seq = sequence(walker, plan)
    nextIs(seq, "3", "4")
end)

test("source order wins over chapter magnitude, specials never jumped", function()
    local seq = sequence(fixture({10, 10, 1, 1, false, 11, 11}))
    nextIs(seq, "1", "3")
    nextIs(seq, "3", "5")
    nextIs(seq, "6", "5", "previous")
end)

test("missing metadata anywhere keeps original navigation", function()
    local walker, plan = fixture({1, 1, 2, 2, 3})
    table.remove(state.response.data.chapters.nodes)
    local seq = sequence(walker, plan)
    nextIs(seq, "1", "2")
    nextIs(seq, "3", "4")
end)

test("malformed response shapes and GraphQL errors fall back", function()
    local responses = { false, {}, { data = {} }, { data = { chapters = {} } },
        { data = { chapters = { nodes = "wrong" } } },
        { data = { chapters = { nodes = { bad = {} } } } },
        { data = { chapters = { nodes = {{id = "1"}} } } },
        { data = { chapters = { nodes = {{id = 1}, {id = 1}} } } },
        { data = { chapters = { nodes = {{id = -1}} } } },
        { data = { chapters = { nodes = {{id = 1.5}} } } },
        { data = { chapters = { nodes = {{id = 2147483648}} } } } }
    for _, response in ipairs(responses) do
        state.now = state.now + 61
        local walker, plan = fixture({1, 1, 2})
        state.response = response
        nextIs(sequence(walker, plan), "1", "2")
    end
    state.now = state.now + 61
    local walker, plan = fixture({1, 1, 2})
    state.response.errors = {{ message = "Unauthorized" }}
    nextIs(sequence(walker, plan), "1", "2", "next")
end)

test("invalid JSON, HTTP auth errors, redirects and thrown requests fall back", function()
    for _, code in ipairs({301, 302, 401, 403, 500}) do
        state.now = state.now + 61
        local walker, plan = fixture({1, 1, 2})
        state.code = code
        nextIs(sequence(walker, plan), "1", "2")
    end
    state.code = nil
    for _, mode in ipairs({"body", "http_error", "no_status", "slow"}) do
        state.now = state.now + 61
        local walker, plan = fixture({1, 1, 2})
        state[mode] = mode == "body" and "{not json" or true
        nextIs(sequence(walker, plan), "1", "2")
        state[mode] = nil
        equal(socketutil.block_timeout, 17)
        equal(socketutil.total_timeout, 29)
    end
    equal(#state.logs, 0, "network exception text must not be logged")
end)

test("oversized metadata falls back", function()
    local walker, plan = fixture({1, 1, 2})
    state.body = json.encode(state.response) .. string.rep(" ", 1024 * 1024)
    nextIs(sequence(walker, plan), "1", "2")
end)

test("one-slot cache expires, refreshes IDs and isolates account, server and manga", function()
    local walker, plan = fixture({1, 1, 2})
    sequence(walker, plan); sequence(walker, plan)
    equal(#state.requests, 1)
    state.now = state.now + 60
    sequence(walker, plan); equal(#state.requests, 2)
    walker = fixture({1, 1, 2, 2})
    sequence(walker, plan); equal(#state.requests, 3)
    -- Synthetic identities only; no real account data belongs in fixtures.
    plan.walker_opts.username = "fixture-account"
    sequence(walker, plan); equal(#state.requests, 4)
    plan.walker_opts.password = "fixture-value"
    sequence(walker, plan); equal(#state.requests, 5)
    plan.url = "https://second.invalid/proxy/api/opds/v1.2/series/7/chapters"
    sequence(walker, plan); equal(#state.requests, 6)
    equal(state.requests[6].url, "https://second.invalid/proxy/api/graphql")
    equal(state.requests[6].user, plan.walker_opts.username)
    equal(state.requests[6].password, plan.walker_opts.password)
    plan.url = "https://second.invalid/proxy/api/opds/v1.2/series/8/chapters"
    state.expected_manga = 8
    sequence(walker, plan); equal(#state.requests, 7)
    state.now = 1
    sequence(walker, plan); equal(#state.requests, 8, "clock rollback expires cache")
end)

test("failed and incomplete metadata is cached briefly, then retried", function()
    local walker, plan = fixture({1, 1, 2})
    state.code = 401
    nextIs(sequence(walker, plan), "1", "2")
    state.code = nil
    nextIs(sequence(walker, plan), "1", "2")
    equal(#state.requests, 1)
    state.now = state.now + 60
    nextIs(sequence(walker, plan), "1", "3")
    equal(#state.requests, 2)
end)

test("canonical same-origin URLs preserve proxy prefixes and reject unsafe shapes", function()
    local walker, plan = fixture({1, 1, 2})
    plan.url = "https://[::1]:8443/proxy/api/opds/v1.2/series/7/chapters?lang=en"
    nextIs(sequence(walker, plan), "1", "3")
    equal(state.requests[1].url, "https://[::1]:8443/proxy/api/graphql")
    for _, candidate in ipairs({"file:///api/opds/v1.2/series/7/chapters",
        "https://fixture@reader.invalid/api/opds/v1.2/series/7/chapters",
        "https://reader.invalid/api/opds/v1.2/series/7/chapters#fragment",
        "https://reader.invalid/api/opds/v1.2/series/2147483648/chapters",
        "https://reader.invalid/api/opds/v1.2/series/7/chapter/1/metadata",
        "https://reader.invalid/api/opds/v1.2/series/no/chapters",
        "https://reader.invalid/api/opds/v1.2/series/7/chapters\n"}) do
        plan.url = candidate
        nextIs(sequence(walker, plan), "1", "2")
    end
    equal(#state.requests, 1)
end)

test("non-Suwayomi and uncollected local sequences stay unchanged", function()
    for _, kind in ipairs({"kavita", "komga"}) do
        local walker, plan = fixture({1, 1, 2})
        plan.driver = { kind = kind, parseCatalogPage = driver.parseCatalogPage }
        nextIs(sequence(walker, plan), "1", "2")
    end
    nextIs({{item_key = "1"}, {item_key = "2"}}, "1", "2")
    equal(#state.requests, 0)
end)

test("metadata suffix maps to DB IDs; remote conflict feeds keep original stops", function()
    local walker, plan = fixture({1, 1, 2}, nil, {"1:metadata", "2", "3"})
    local seq = sequence(walker, plan)
    equal(seq[1].item_key, "1", "only Meguru normalizes identity")
    nextIs(seq, "1", "3")
    for _, suffix in ipairs({":remote", ":remote:metadata", ":unexpected"}) do
        walker, plan = fixture({1, 1, 2}, nil, {"1", "1" .. suffix, "3"})
        seq = sequence(walker, plan)
        equal(Feed.neighbor(seq, "1", "next"), original_neighbor(seq, "1", "next"))
    end
    equal(#state.requests, 1, "conflicts need no metadata query")
end)

test("repeated plugin creation and patch loading never stack wrappers", function()
    local wrapped_collect, wrapped_neighbor = Feed.collect, Feed.neighbor
    state.callbacks[1]({ name = "meguru" })
    dofile("2-newedia-meguru-dupskip.lua")
    state.callbacks[2]({ name = "meguru" })
    equal(Feed.collect, wrapped_collect)
    equal(Feed.neighbor, wrapped_neighbor)
    nextIs(sequence(fixture({1, 1, 2})), "1", "3")
    equal(#state.requests, 1)
end)

test("partial initialization failure changes no module functions and permits retry", function()
    reset(true)
    state.decoder_available = false
    state.callbacks[1]({ name = "meguru" })
    equal(Feed.collect, original_collect)
    equal(Feed.neighbor, original_neighbor)
    equal(Feed._newedia_dupskip, nil)
    equal(#state.logs, 1)
    state.decoder_available = true
    state.callbacks[1]({ name = "meguru" })
    assert(Feed.neighbor ~= original_neighbor)
    nextIs(sequence(fixture({1, 1, 2})), "1", "3")
end)

test("collect preserves extra returns, nil slots and original exceptions", function()
    reset(true)
    Feed.collect = function(...)
        local items, count = original_collect(...)
        return items, count, nil, "sentinel", nil
    end
    state.callbacks[1]({ name = "meguru" })
    local function check(...)
        equal(select("#", ...), 5)
        local _, count, hole, sentinel, tail = ...
        equal(count, 0); equal(hole, nil); equal(sentinel, "sentinel"); equal(tail, nil)
    end
    check(Feed.collect(fixture({1, 1, 2})))
    reset(true)
    Feed.collect = function() error("original parse failure") end
    state.callbacks[1]({ name = "meguru" })
    local ok, message = pcall(Feed.collect, fixture({1, 1, 2}))
    equal(ok, false)
    assert(message:find("original parse failure", 1, true))
end)

test("incomplete walks are not enriched and six-page limit is unchanged", function()
    equal(Feed.TAP_PAGES, 6)
    local walker, plan = fixture({1, 1, 2})
    walker.complete = false
    nextIs(sequence(walker, plan), "1", "2")
    equal(#state.requests, 0)
end)

os.time = original_time
print("Passed " .. passed .. " tests using real Meguru Feed, drivers, ordering and dedupe.")
